
@{
    ViewData["Title"] = "Courts";
}

<section class="page-header">
    <div class="container">
        <p class="small-label">BRS / COURTS</p>
        <h1>Find Your Court.</h1>
        <p>Explore our basketball courts and choose where you want to play.</p>
    </div>
</section>

<section class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Our Courts</h2>
            <p class="text-muted">Choose a court for your next game.</p>
        </div>
        <span class="badge bg-dark p-2">3 Courts</span>
    </div>

    <div class="row g-4">

        <div class="col-lg-4 col-md-6">
            <div class="court-card">
                <div class="court-picture picture-one">
                    <i class="bi bi-basketball"></i>
                    <span>COURT 01</span>
                </div>
                <div class="p-4">
                    <h4>Indoor Court</h4>
                    <p class="text-muted">
                        <i class="bi bi-geo-alt"></i> Main Sports Center
                    </p>
                    <hr />
                    <p><i class="bi bi-house"></i> Indoor</p>
                    <p><i class="bi bi-people"></i> Full Basketball Court</p>
                    <a href="#" class="btn btn-dark w-100 mt-2">Reserve Court</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="court-card">
                <div class="court-picture picture-two">
                    <i class="bi bi-basketball"></i>
                    <span>COURT 02</span>
                </div>
                <div class="p-4">
                    <h4>Outdoor Court</h4>
                    <p class="text-muted">
                        <i class="bi bi-geo-alt"></i> Community Sports Area
                    </p>
                    <hr />
                    <p><i class="bi bi-sun"></i> Outdoor</p>
                    <p><i class="bi bi-people"></i> Full Basketball Court</p>
                    <a href="#" class="btn btn-dark w-100 mt-2">Reserve Court</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="court-card">
                <div class="court-picture picture-three">
                    <i class="bi bi-basketball"></i>
                    <span>COURT 03</span>
                </div>
                <div class="p-4">
                    <h4>Training Court</h4>
                    <p class="text-muted">
                        <i class="bi bi-geo-alt"></i> Training Facility
                    </p>
                    <hr />
                    <p><i class="bi bi-house"></i> Indoor</p>
                    <p><i class="bi bi-people"></i> Half Basketball Court</p>
                    <a href="#" class="btn btn-dark w-100 mt-2">Reserve Court</a>
                </div>
            </div>
        </div>

    </div>
</section>
