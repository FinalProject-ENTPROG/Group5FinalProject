
@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="hero-tag">
                    <i class="bi bi-basketball"></i>
                    YOUR GAME STARTS HERE
                </span>

                <h1 class="hero-title">
                    Find Your Court.<br />
                    <span>Play Your Game.</span>
                </h1>

                <p class="hero-description">
                    Welcome to BRS. Manage your school's basketball
                    court reservations with ease.
                </p>

                @if (User.IsInRole("Student"))
                {
                    <div class="d-flex flex-wrap gap-2 mt-3">

                        <a asp-controller="Reservations"
                           asp-action="Create"
                           class="btn btn-book">
                            Reserve Now
                            <i class="bi bi-arrow-right"></i>
                        </a>

                        <a asp-controller="Reservations"
                           asp-action="Index"
                           class="btn btn-outline-light rounded-pill px-4">
                            <i class="bi bi-calendar-check"></i>
                            My Reservations
                        </a>

                        <a asp-controller="Reservations"
                           asp-action="Schedule"
                           class="btn btn-outline-light rounded-pill px-4">
                            <i class="bi bi-calendar-week"></i>
                            Court Schedule
                        </a>

                        <a asp-controller="Reservations"
                           asp-action="Notifications"
                           class="btn btn-outline-light rounded-pill px-4">
                            <i class="bi bi-bell"></i>
                            Notifications
                        </a>

                        <a asp-controller="StudentProfile"
                           asp-action="Index"
                           class="btn btn-light rounded-pill px-4">
                            <i class="bi bi-person-circle"></i>
                            Student Profile
                        </a>

                    </div>
                }
                else if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Reservations"
                       asp-action="Admin"
                       class="btn btn-book mt-3">
                        Manage Reservations
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <a asp-controller="Reservations"
                       asp-action="Schedule"
                       class="btn btn-outline-light rounded-pill px-4 mt-3 ms-2">
                        <i class="bi bi-calendar-week"></i>
                        Court Schedule
                    </a>
                }

            </div>

            <div class="col-lg-5 text-center mt-5 mt-lg-0">

                <div class="basketball-icon">
                    <i class="bi bi-basketball"></i>
                </div>

                <h3 class="text-white fw-bold mt-3">
                    It's Game Time.
                </h3>

                <p class="text-white-50">
                    Your next game is just a reservation away.
                </p>

            </div>
        </div>
    </div>
</section>

<section class="container py-5">

    <div class="text-center mb-5">
        <p class="section-label">WELCOME TO BRS</p>

        <h2 class="fw-bold">
            Basketball Court Reservation System
        </h2>

        <p class="text-muted">
            A simple and organized way to manage basketball court schedules.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-calendar-check feature-icon"></i>
                <h5>Easy Reservations</h5>
                <p>
                    Choose your preferred date and time and submit your reservation.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-clock feature-icon"></i>
                <h5>Schedule Checking</h5>
                <p>
                    Check the court schedule and available time slots.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-shield-check feature-icon"></i>
                <h5>Organized Approval</h5>
                <p>
                    Reservations are reviewed and approved by the administrator.
                </p>
            </div>
        </div>

    </div>

</section>

<section class="container pb-5">

    <div class="booking-banner">

        <div>
            @if (User.IsInRole("Student"))
            {
                <h2 class="fw-bold">Ready to Play?</h2>
                <p class="mb-0">
                    Reserve your school's basketball court today.
                </p>
            }
            else if (User.IsInRole("Admin"))
            {
                <h2 class="fw-bold">Manage BRS</h2>
                <p class="mb-0">
                    Review and manage student reservations.
                </p>
            }
        </div>

        @if (User.IsInRole("Student"))
        {
            <a asp-controller="Reservations"
               asp-action="Create"
               class="btn btn-light rounded-pill px-4">
                Reserve Now
                <i class="bi bi-arrow-right"></i>
            </a>
        }
        else if (User.IsInRole("Admin"))
        {
            <a asp-controller="Reservations"
               asp-action="Admin"
               class="btn btn-light rounded-pill px-4">
                View Requests
                <i class="bi bi-arrow-right"></i>
            </a>
        }

    </div>

</section>
