
@model firstASP.Models.Reservation

@{
    ViewData["Title"] = "Reserve a Court";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="text-center mb-4">
                <p class="section-label">BENILDE STUDENTS</p>
                <h1 class="fw-bold">Reserve Your Court</h1>
                <p class="text-muted">
                    Enter your student information and preferred schedule.
                </p>
            </div>

            <div class="card shadow-sm border-0 p-4">

                <h4 class="fw-bold mb-3">
                    <i class="bi bi-basketball"></i>
                    School Basketball Court
                </h4>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="StudentIdNumber"
                               class="form-label fw-bold">
                            Student ID Number
                        </label>

                        <input asp-for="StudentIdNumber"
                               class="form-control"
                               placeholder="Enter your Benilde student ID" />

                        <span asp-validation-for="StudentIdNumber"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BenildeEmail"
                               class="form-label fw-bold">
                            Benilde Email
                        </label>

                        <input asp-for="BenildeEmail"
                               type="email"
                               class="form-control"
                               placeholder="Enter your Benilde email" />

                        <span asp-validation-for="BenildeEmail"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StudentName"
                               class="form-label fw-bold">
                            Full Name
                        </label>

                        <input asp-for="StudentName"
                               class="form-control"
                               placeholder="Enter your full name" />

                        <span asp-validation-for="StudentName"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StartDateTime"
                               class="form-label fw-bold">
                            Starting Date and Time
                        </label>

                        <input asp-for="StartDateTime"
                               type="datetime-local"
                               asp-format="{0:yyyy-MM-ddTHH:mm}"
                               class="form-control" />

                        <span asp-validation-for="StartDateTime"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="EndDateTime"
                               class="form-label fw-bold">
                            Ending Date and Time
                        </label>

                        <input asp-for="EndDateTime"
                               type="datetime-local"
                               asp-format="{0:yyyy-MM-ddTHH:mm}"
                               class="form-control" />

                        <span asp-validation-for="EndDateTime"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-dark w-100 py-3">
                        Submit Reservation
                        <i class="bi bi-arrow-right"></i>
                    </button>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-dark w-100 mt-2">
                        Back to Home
                    </a>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
