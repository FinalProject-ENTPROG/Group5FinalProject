
@model IEnumerable<firstASP.Models.Reservation>

@{
    ViewData["Title"] = "My Reservations";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <p class="section-label">BRS SCHEDULE</p>
        <h1 class="fw-bold">My Reservations</h1>
        <p class="text-muted">
            View your basketball court reservations and their current status.
        </p>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <a asp-controller="Reservations"
           asp-action="Create"
           class="btn btn-dark">
            <i class="bi bi-plus-lg"></i> Make a Reservation
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">
                    <tr>
                        <th>Student ID</th>
                        <th>Student Name</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-calendar-x display-5"></i>
                                <p class="mt-3 mb-0">
                                    You haven't made any reservations yet.
                                </p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var reservation in Model)
                        {
                            <tr>
                                <td>@reservation.StudentIdNumber</td>
                                <td>@reservation.StudentName</td>

                                <td>
                                    @reservation.StartDateTime.ToString("MMM dd, yyyy hh:mm tt")
                                </td>

                                <td>
                                    @reservation.EndDateTime.ToString("MMM dd, yyyy hh:mm tt")
                                </td>

                                <td>
                                    @if (reservation.Status == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else if (reservation.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Pending
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>

        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-controller="Home"
           asp-action="Index"
           class="text-dark">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
    </div>

</div>
